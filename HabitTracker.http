@host=http://localhost:8080
@userId=11111111-1111-1111-1111-111111111111
@habitId=22222222-2222-2222-2222-222222222222

### health
GET {{host}}/health

### swagger
GET {{host}}/swagger

### users
GET {{host}}/api/users

### habits
GET {{host}}/api/users/{{userId}}/habits

### create habit
POST {{host}}/api/users/{{userId}}/habits
Content-Type: application/json

{
  "title": "Тренировка",
  "description": "20 минут дома",
  "frequency": 1,
  "targetCountPerPeriod": 1,
  "color": "orange",
  "reminderTime": "19:00"
}

### complete habit
POST {{host}}/api/habits/{{habitId}}/completions
Content-Type: application/json

{
  "date": null,
  "note": "Выполнено"
}

### stats
GET {{host}}/api/users/{{userId}}/stats

### due reminders
GET {{host}}/api/reminders/due?time=09:00
